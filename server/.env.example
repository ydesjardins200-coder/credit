# iBoost server environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Runtime ---
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed CORS origins.
# In dev, leave blank or set to your local frontend URL.
# In production, set to your Netlify domain: https://iboost.netlify.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Supabase ---
# Find these in your Supabase dashboard under Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon key — used by the auth middleware to verify user JWTs.
SUPABASE_ANON_KEY=your-anon-key

# Service-role key — bypasses RLS. SERVER ONLY. Never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin cross-service auth ---
# Shared secret the iboost-admin service sends in the x-admin-shared-secret
# header when calling GET /api/integrations/status. Must match the same
# value set on the admin service. A long random string; rotate together.
ADMIN_INTEGRATIONS_SECRET=replace-with-long-random-string

# --- Frontend URL (for Stripe redirect targets) ---
# Where Stripe sends the user after the hosted checkout page.
FRONTEND_URL=https://iboostcredit.netlify.app

# --- Payments: Stripe (sandbox/test keys until launch) ---
# Secret key — SERVER ONLY, never expose. Use sk_test_… in sandbox.
STRIPE_SECRET_KEY=sk_test_your_key
# Webhook signing secret — from the Stripe webhook endpoint config.
# Use the whsec_… value Stripe shows for your endpoint (or the Stripe
# CLI's `stripe listen` secret in local dev).
STRIPE_WEBHOOK_SECRET=whsec_your_secret
# Recurring monthly Price IDs (CAD only for v1; US launch undecided).
STRIPE_PRICE_ESSENTIAL_CAD=price_your_essential_cad
STRIPE_PRICE_COMPLETE_CAD=price_your_complete_cad
